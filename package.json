{
  "name": "eyesonly",
  "version": "2.0.0",
  "private": true,
  "description": "Live spy-game platform: real-time director console, field-ops coordination, and an embedded ASCII stealth roguelike — all mapped to real Sandpoint, Idaho geography. Cloudflare Workers powered.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:ops": "esbuild src/ops-ui/index.tsx --bundle --outfile=public/ops/app.js --jsx=automatic --jsx-import-source=preact --minify --target=es2020",
    "build:mmode": "esbuild src/m-mode/index.tsx --bundle --outfile=public/m/app.js --jsx=automatic --jsx-import-source=preact --minify --target=es2020",
    "build:ui": "npm run build:ops && npm run build:mmode",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute database_id --remote --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute database_id --local --file=migrations/0001_init.sql",
    "types": "wrangler types",
    "build:enemyCatalog": "node scripts/build-enemy-catalog.mjs",
    "init:enemyCatalog": "node scripts/init-enemy-catalog-from-runtime.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "preact": "^10.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.67.0"
  }
}
