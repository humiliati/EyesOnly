{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story Beat Database (ARG)",
  "description": "All narrative moments with triggers, text, choices, and outcomes",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "text", "trigger"],
    "properties": {
      "id": { "type": "string" },
      "trigger": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "location_enter",
              "item_acquired",
              "synergy_complete",
              "dialogue_complete",
              "time_elapsed",
              "state_threshold",
              "manual"
            ]
          },
          "target": { "type": "string" },
          "state_min": { "type": "object", "additionalProperties": { "type": "integer" } },
          "state_max": { "type": "object", "additionalProperties": { "type": "integer" } },
          "once": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "text": { "type": "array", "items": { "type": "string" } },
      "choices": {
        "type": ["array", "null"],
        "items": {
          "type": "object",
          "required": ["id", "prompt", "outcomes"],
          "properties": {
            "id": { "type": "string" },
            "prompt": { "type": "string" },
            "requirements": { "type": ["object", "null"] },
            "outcomes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "effects": {
        "type": ["object", "null"],
        "properties": {
          "delta": { "type": "object", "additionalProperties": { "type": "integer" } },
          "set": { "type": "object", "additionalProperties": { "type": ["boolean", "string", "number", "null"] } },
          "unlock_beats": { "type": "array", "items": { "type": "string" } },
          "grant_items": { "type": "array", "items": { "type": "string" } },
          "teleport": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
