{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flapsandseals.com/schemas/gone-rogue/enemy-catalog.schema.json",
  "title": "Gone Rogue Enemy Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cards", "decks"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema/data version for enemy-catalog.json"
    },
    "notes": { "type": "string" },

    "cards": {
      "type": "object",
      "description": "Designer-facing enemy attack cards keyed by EATK-* id.",
      "propertyNames": { "pattern": "^EATK-[0-9]{3}$" },
      "additionalProperties": { "$ref": "#/definitions/enemyCard" }
    },

    "decks": {
      "type": "object",
      "description": "Enemy deck recipes keyed by enemy deck type (usually matches enemyType).",
      "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
      "additionalProperties": { "$ref": "#/definitions/enemyDeck" }
    },

    "archetypes": {
      "type": "object",
      "description": "Optional higher-level archetypes (designer vocabulary) that map floors/contexts to decks.",
      "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
      "additionalProperties": { "$ref": "#/definitions/enemyArchetype" },
      "default": {}
    },

    "variants": {
      "type": "object",
      "description": "Optional ground-effect / environment variants applied as patches.",
      "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
      "additionalProperties": { "$ref": "#/definitions/enemyVariant" },
      "default": {}
    },

    "spawnBands": {
      "type": "array",
      "description": "Optional: floor band weighting to spawn archetypes.",
      "items": { "$ref": "#/definitions/spawnBand" },
      "default": []
    }
  },

  "definitions": {
    "enemyCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "emoji", "intentType", "targetType", "damage", "accuracy", "speed", "effects"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "emoji": { "type": "string", "minLength": 1 },
        "intentType": { "type": "string", "minLength": 1 },
        "targetType": { "type": "string", "enum": ["player", "self", "ally", "area"] },

        "damage": { "type": "integer", "minimum": 0 },
        "accuracy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 10 },

        "hits": { "type": "integer", "minimum": 1 },

        "effects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/effect" }
        },

        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "synergyTags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },

        "rarity": {
          "type": "string",
          "enum": ["common", "uncommon", "rare", "elite"],
          "default": "common"
        },
        "stealValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0,
          "description": "Heuristic value used by theft systems to prefer high-impact steals."
        },

        "designNote": { "type": "string" },
        "_designNote": { "type": "string" }
      }
    },

    "enemyDeck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "handSize", "exposedTags"],
      "properties": {
        "keyName": { "type": "string" },

        "pool": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^EATK-[0-9]{3}$" },
          "description": "Candidate card IDs (duplicates allowed for weighting)."
        },

        "handSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "How many cards this enemy draws into its hand (random draw from pool unless deckMode=fixed)."
        },

        "deckMode": {
          "type": "string",
          "enum": ["fixed", "draw"],
          "default": "fixed",
          "description": "fixed: output cards exactly as pool list. draw: randomly draw handSize from pool at combat start."
        },

        "guarantees": {
          "type": "array",
          "items": { "type": "string", "pattern": "^EATK-[0-9]{3}$" },
          "default": [],
          "description": "Card IDs that must appear in the hand (compiler enforces within handSize)."
        },

        "exposedTags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_]+$" },
          "default": [],
          "description": "Theft vocabulary: pickpocket/disarm/sleight/hack/intimidate/bribe"
        },

        "note": { "type": "string" },
        "_note": { "type": "string" }
      }
    },

    "enemyArchetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },

        "baseStats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hp": { "$ref": "#/definitions/rangeInt" },
            "sightRange": { "$ref": "#/definitions/rangeInt" },
            "moveSpeed": { "$ref": "#/definitions/rangeNum" }
          },
          "default": {}
        },

        "deckByFloor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxFloor", "deck"],
            "properties": {
              "maxFloor": { "type": "integer", "minimum": 1 },
              "deck": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
            }
          },
          "default": []
        }
      }
    },

    "enemyVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whenGroundEffects", "patch"],
      "properties": {
        "whenGroundEffects": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deckOverride": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "default": {}
            },
            "addCards": {
              "type": "array",
              "items": { "type": "string", "pattern": "^EATK-[0-9]{3}$" },
              "default": []
            },
            "removeCards": {
              "type": "array",
              "items": { "type": "string", "pattern": "^EATK-[0-9]{3}$" },
              "default": []
            },
            "addExposedTags": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z_]+$" },
              "default": []
            },
            "statMods": {
              "type": "object",
              "additionalProperties": { "type": "number" },
              "default": {}
            }
          },
          "default": {}
        }
      }
    },

    "spawnBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floors", "weights"],
      "properties": {
        "floors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 },
          "description": "[minFloor, maxFloor] inclusive"
        },
        "weights": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z0-9_]+$" },
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Archetype key -> relative weight"
        }
      }
    },

    "rangeInt": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer" }
    },
    "rangeNum": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },

    "effect": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      },
      "description": "Enemy-card effect payloads are engine-defined; schema only enforces a type string."
    }
  }
}
