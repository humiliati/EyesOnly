{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gone Rogue Item",
  "type": "object",
  "required": ["id", "name", "emoji"],
  "properties": {
    "id": { "type": "string", "pattern": "^ITM-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
    "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"], "default": "common" },
    "stackable": { "type": "boolean", "default": false },
    "maxStack": { "type": "integer", "minimum": 1, "default": 1 },
    "synergyTags": { "type": "array", "items": { "type": "string" } },
    "use": {
      "type": "object",
      "required": ["targetType", "effects"],
      "properties": {
        "targetType": { "type": "string", "enum": ["self", "enemy", "ground", "npc", "item"] },
        "cost": { "type": "integer", "minimum": 0, "default": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "number" },
        "duration": { "type": "integer", "minimum": 0 },
        "condition": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
