{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gone Rogue Inventory Item",
  "type": "object",
  "required": ["id", "name", "emoji", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^ITM-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
    "type": { "type": "string", "enum": ["consumable", "equipment", "resource", "key", "deployable"] },
    "subtype": { "type": "string" },

    "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"], "default": "common" },

    "stackable": { "type": "boolean", "default": false },
    "maxStack": { "type": "integer", "minimum": 1, "default": 1 },

    "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
    "synergyTags": { "type": "array", "items": { "type": "string" } },

    "equipSlot": { "type": "string", "enum": ["active", "passive", "none"], "default": "none" },
    "description": { "type": "string", "maxLength": 256 }
  },
  "additionalProperties": true,
  "definitions": {
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "number" },
        "duration": { "type": "integer", "minimum": 0 },
        "condition": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
