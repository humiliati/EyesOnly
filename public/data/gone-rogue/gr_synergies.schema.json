{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gone Rogue Synergy",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^SYN-[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "itemId": { "type": "string", "pattern": "^ITM-[0-9]{3}$" },
    "cardId": { "type": "string", "pattern": "^ACT-[0-9]{3}$" },
    "trigger": { "type": "string", "enum": ["card_on_item", "item_then_card", "simultaneous", "combo_chain"] },
    "visual": { "type": "string", "maxLength": 12 },
    "maxUsesPerCombat": { "type": "integer", "minimum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "effects": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
