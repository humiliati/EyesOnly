{
  // EyesOnly — Spec-Ops CTF Engine
  // Static terminal + Hono API + Durable Objects
  "name": "flapsandseals",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-02-13",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (the original terminal UI)
  "assets": {
    "directory": "public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // D1 SQLite database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database_id",
      "database_id": "3777d321-7b41-44fa-b2f3-0413717eea8b"
    }
  ],

  // Durable Objects for real-time WebSocket state
  "durable_objects": {
    "bindings": [
      {
        "name": "SCENARIO_ROOM",
        "class_name": "ScenarioRoom"
      }
    ]
  },

  // R2 bucket for uploaded assets (dead drop photos, etc.)
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "eyesonly-assets"
    }
  ],

  // Durable Object migrations
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScenarioRoom"]
    }
  ],

  // Scheduled triggers — deadman check every 5 minutes
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Non-secret environment variables
  // VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are SECRETS — set with:
  //   wrangler secret put VAPID_PUBLIC_KEY
  //   wrangler secret put VAPID_PRIVATE_KEY
  "vars": {
    "VAPID_SUBJECT": "mailto:ops@flapsandseals.com"
  }
}
